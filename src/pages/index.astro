---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import SlotCard from '../components/SlotCard.astro';
import TopBanner from '../components/TopBanner.astro';

import PersonajeCarousel from '../components/PersonajeCarousel.jsx';
import ActualidadCarousel from '../components/ActualidadCarousel.jsx';
import ApoyoComunidadCarousel from '../components/ApoyoComunidadCarousel.jsx';
import SocialVideoCarousel from '../components/SocialVideoCarousel.jsx';

import { posts as localPosts } from '../data/posts';

// ---------------------------------------------------------------------------
// CONFIGURACIÓN
// ---------------------------------------------------------------------------
const apiUrl = import.meta.env.WORDPRESS_API_URL || 'https://realidades.lastorres308.com/graphql';

// ID de la página "Configuración Banners" en WordPress (post=106 en la URL del editor)
const BANNERS_PAGE_ID = '106';

// Pon en false cuando todo funcione para ocultar el recuadro rojo de diagnóstico
const MOSTRAR_DIAGNOSTICO = false;

// Si es true, Actualidad no repite las entradas que salen en las posiciones 6 a 12
const EXCLUIR_6_A_12_DE_ACTUALIDAD = false;

// ---------------------------------------------------------------------------
// HELPERS
// ---------------------------------------------------------------------------
const diagnostico: string[] = [];
let graphqlErrors: any[] = [];

async function gql(query: string): Promise<any> {
  const response = await fetch(apiUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query })
  });
  if (!response.ok) {
    throw new Error(`HTTP ${response.status} ${response.statusText}`);
  }
  return response.json();
}

function limpiarHtml(texto: string = ''): string {
  return texto
    .replace(/<[^>]*>/g, '')
    .replace(/&hellip;|&#8230;/g, '…')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&#8211;|&ndash;/g, '–')
    .replace(/&#8217;|&rsquo;/g, '’')
    .replace(/&#8220;|&#8221;|&ldquo;|&rdquo;/g, '"')
    .replace(/\[&hellip;\]|\[…\]/g, '…')
    .trim();
}

// Un Select de ACF puede llegar como string o como array de strings
function valorSelect(v: any): string {
  if (Array.isArray(v)) return String(v[0] ?? '');
  return v == null ? '' : String(v);
}

// ---------------------------------------------------------------------------
// CONSULTA 1: ENTRADAS (separada para que un error en banners no la tumbe)
// ---------------------------------------------------------------------------
const QUERY_POSTS = `
  query GetPosts {
    posts(first: 50, where: { orderby: { field: DATE, order: DESC } }) {
      nodes {
        id
        title
        slug
        date
        excerpt
        featuredImage { node { sourceUrl } }
        camposMultimedia {
          urlVideoYoutube
          urlVideoTiktok
          urlVideoInstagram
        }
        actorsSociales { nodes { name } }
        camposHome {
          insigniaNota
          destacadoHome
          ordenDestacado
          esPersonaje
          apoyoComunidad
        }
      }
    }
  }
`;

// ---------------------------------------------------------------------------
// CONSULTA 2: BANNERS Y AUSPICIADORES
// Los campos Image de ACF devuelven una "conexión": la URL está en .node.sourceUrl
// ---------------------------------------------------------------------------
const QUERY_BANNERS = `
  query GetBanners {
    page(id: "${BANNERS_PAGE_ID}", idType: DATABASE_ID) {
      bannersGlobales {
        banner1Imagen { node { sourceUrl } }
        banner1Sticky
        banner2Imagen { node { sourceUrl } }
        banner3Imagen { node { sourceUrl } }
        banner3Posicion
        banner4Imagen { node { sourceUrl } }
        banner4Posicion
        logo1 { node { sourceUrl } }
        logo2 { node { sourceUrl } }
        logo3 { node { sourceUrl } }
        logo4 { node { sourceUrl } }
        logo5 { node { sourceUrl } }
        logo6 { node { sourceUrl } }
      }
    }
  }
`;

let wpPosts: any[] = [];
let bannerData: any = null;

try {
  const json = await gql(QUERY_POSTS);
  if (json.errors) {
    graphqlErrors.push(...json.errors);
    diagnostico.push(`ENTRADAS: GraphQL devolvió ${json.errors.length} error(es).`);
  }
  wpPosts = json.data?.posts?.nodes || [];
  if (wpPosts.length === 0 && !json.errors) {
    diagnostico.push('ENTRADAS: la API respondió bien pero devolvió 0 entradas (¿están publicadas?).');
  }
} catch (error: any) {
  diagnostico.push(`ENTRADAS: error de conexión/red → ${error.message || String(error)}`);
}

try {
  const json = await gql(QUERY_BANNERS);
  if (json.errors) {
    graphqlErrors.push(...json.errors);
    diagnostico.push(`BANNERS: GraphQL devolvió ${json.errors.length} error(es).`);
  }
  bannerData = json.data?.page?.bannersGlobales || null;
  if (!bannerData && !json.errors) {
    diagnostico.push(`BANNERS: no se encontró la página con ID ${BANNERS_PAGE_ID} o no tiene campos.`);
  }
} catch (error: any) {
  diagnostico.push(`BANNERS: error de conexión/red → ${error.message || String(error)}`);
}

const usandoRespaldo = wpPosts.length === 0;
if (usandoRespaldo) {
  diagnostico.push('Se están mostrando las entradas de RESPALDO (localPosts), no las de WordPress.');
}

console.log('[WP]', {
  apiUrl,
  posts: wpPosts.length,
  banners: !!bannerData,
  banner3Posicion: bannerData?.banner3Posicion,
  banner4Posicion: bannerData?.banner4Posicion,
  errores: graphqlErrors.length
});

// ---------------------------------------------------------------------------
// PROCESAMIENTO DE ENTRADAS
// ---------------------------------------------------------------------------
function fechaCorta(fecha: string): string {
  const d = new Date(fecha);
  if (isNaN(d.getTime())) return '';
  // El texto se genera aquí (no en el navegador) para evitar diferencias de zona horaria
  return d.toLocaleDateString('es-PE', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}

const respaldoFormateado = localPosts.map((p: any) => ({
  id: String(p.id),
  title: p.title,
  slug: p.slug,
  date: p.date,
  fechaTexto: fechaCorta(p.date),
  excerpt: p.excerpt,
  featuredImage: p.featuredImage,
  videoYoutube: p.videoYoutube || '',
  videoTiktok: '',
  videoInstagram: '',
  // El respaldo trae [{ name }]; NewsCard espera strings → se normaliza aquí
  actoresSociales: (p.actoresSociales || [])
    .map((a: any) => (typeof a === 'string' ? a : a?.name))
    .filter(Boolean),
  insignia: '',
  destacadoHome: 'ninguno',
  ordenDestacado: 99,
  esPersonaje: false,
  apoyoComunidad: false
}));

const allPostsFormatted: any[] = (!usandoRespaldo
  ? wpPosts.map((post: any) => ({
      id: String(post.id),
      title: limpiarHtml(post.title),
      slug: post.slug,
      date: post.date,
      fechaTexto: fechaCorta(post.date),
      excerpt: limpiarHtml(post.excerpt),
      featuredImage:
        post.featuredImage?.node?.sourceUrl ||
        'https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?w=1200',
      videoYoutube: post.camposMultimedia?.urlVideoYoutube || '',
      videoTiktok: post.camposMultimedia?.urlVideoTiktok || '',
      videoInstagram: post.camposMultimedia?.urlVideoInstagram || '',
      actoresSociales: (post.actorsSociales?.nodes || [])
        .map((n: any) => (typeof n === 'string' ? n : n?.name))
        .filter(Boolean),
      insignia: post.camposHome?.insigniaNota || '',
      destacadoHome: valorSelect(post.camposHome?.destacadoHome) || 'ninguno',
      ordenDestacado: parseInt(post.camposHome?.ordenDestacado) || 99,
      esPersonaje: Boolean(post.camposHome?.esPersonaje),
      apoyoComunidad: Boolean(post.camposHome?.apoyoComunidad)
    }))
  : respaldoFormateado
).sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime()); // más recientes primero

// ---------------------------------------------------------------------------
// BANNERS Y LOGOS (ACF Image → .node.sourceUrl)
// ---------------------------------------------------------------------------
const banner1Src: string = bannerData?.banner1Imagen?.node?.sourceUrl || '';
const banner1Sticky = Boolean(bannerData?.banner1Sticky);
const banner2Src: string = bannerData?.banner2Imagen?.node?.sourceUrl || '';
const banner3Src: string = bannerData?.banner3Imagen?.node?.sourceUrl || '';
const banner4Src: string = bannerData?.banner4Imagen?.node?.sourceUrl || '';

const auspiciadoresReales: string[] = [
  bannerData?.logo1?.node?.sourceUrl,
  bannerData?.logo2?.node?.sourceUrl,
  bannerData?.logo3?.node?.sourceUrl,
  bannerData?.logo4?.node?.sourceUrl,
  bannerData?.logo5?.node?.sourceUrl,
  bannerData?.logo6?.node?.sourceUrl
].filter(Boolean);

// Resumen de lo que llegó desde WordPress (se ve en el recuadro rojo mientras MOSTRAR_DIAGNOSTICO = true)
diagnostico.push(
  `BANNERS recibidos → banner1: ${banner1Src ? 'sí' : 'NO'} | banner2: ${banner2Src ? 'sí' : 'NO'} | ` +
  `banner3: ${banner3Src ? 'sí' : 'NO'} (posición: ${JSON.stringify(bannerData?.banner3Posicion ?? null)}) | ` +
  `banner4: ${banner4Src ? 'sí' : 'NO'} (posición: ${JSON.stringify(bannerData?.banner4Posicion ?? null)}) | ` +
  `logos: ${auspiciadoresReales.length} de 6`
);
if (!banner3Src || !banner4Src || auspiciadoresReales.length < 6) {
  diagnostico.push('DATOS CRUDOS de bannersGlobales: ' + JSON.stringify(bannerData ?? null).slice(0, 1500));
}

// Posición de inserción: el Select puede devolver "Reemplazar Post 4", "post_4", "4", etc.
// Se toma el número que aparezca (válido de 2 a 12).
function posicionDeBanner(valor: any, porDefecto: number): number {
  const m = valorSelect(valor).match(/\d+/);
  const n = m ? parseInt(m[0]) : porDefecto;
  return n >= 2 && n <= 12 ? n : porDefecto;
}

const bannersEnPosicion: Record<number, string> = {};
if (banner3Src) bannersEnPosicion[posicionDeBanner(bannerData?.banner3Posicion, 4)] = banner3Src;
if (banner4Src) {
  const pos4 = posicionDeBanner(bannerData?.banner4Posicion, 7);
  if (!bannersEnPosicion[pos4]) bannersEnPosicion[pos4] = banner4Src;
}

// ---------------------------------------------------------------------------
// REPARTO DE ENTRADAS EN LAS POSICIONES 1 A 12
// ---------------------------------------------------------------------------
// Personaje y Apoyo a la Comunidad solo salen en su propio carrusel
const generales = allPostsFormatted.filter((p: any) => !p.esPersonaje && !p.apoyoComunidad);
const destacadosMarcados = generales.filter((p: any) => p.destacadoHome === 'destacados');
const idsDestacadosMarcados = new Set<string>(destacadosMarcados.map((p: any) => p.id));

const usados = new Set<string>();
const posts: Record<number, any> = {}; // posts[n] = entrada que va en la posición n

// 1) Destacados con su número de orden. Si el orden se repite, gana el más reciente
//    (generales ya viene ordenado por fecha, el primero que coincide es el más nuevo).
for (let n = 1; n <= 5; n++) {
  if (bannersEnPosicion[n]) continue;
  const candidato = destacadosMarcados.find((p: any) => p.ordenDestacado === n && !usados.has(p.id));
  if (candidato) {
    posts[n] = candidato;
    usados.add(candidato.id);
  }
}

// 2) Posiciones 1-5 que quedaron vacías: primero otros destacados, luego las más recientes
for (let n = 1; n <= 5; n++) {
  if (bannersEnPosicion[n] || posts[n]) continue;
  const restantesDestacados = destacadosMarcados
    .filter((p: any) => !usados.has(p.id))
    .sort((a: any, b: any) => a.ordenDestacado - b.ordenDestacado);
  const relleno = restantesDestacados[0] || generales.find((p: any) => !usados.has(p.id));
  if (relleno) {
    posts[n] = relleno;
    usados.add(relleno.id);
  }
}

const idsTop5 = new Set<string>(usados);

// 3) Posiciones 6-12. Primero los destacados que quedaron fuera de 1-5 (por ejemplo, porque un banner
//    ocupó su posición): "pasan a las siguientes posiciones". Después, las más recientes.
for (let n = 6; n <= 12; n++) {
  if (bannersEnPosicion[n]) continue;
  const desplazado = destacadosMarcados
    .filter((p: any) => !usados.has(p.id))
    .sort((a: any, b: any) => a.ordenDestacado - b.ordenDestacado)[0];
  const siguiente = desplazado || generales.find((p: any) => !usados.has(p.id));
  if (siguiente) {
    posts[n] = siguiente;
    usados.add(siguiente.id);
  }
}

const slot = (n: number) => ({ banner: bannersEnPosicion[n], post: posts[n] });
const hayAlgo = (n: number) => Boolean(bannersEnPosicion[n] || posts[n]);

// ---------------------------------------------------------------------------
// CARRUSELES
// ---------------------------------------------------------------------------
const personajesList = allPostsFormatted
  .filter((p: any) => p.esPersonaje)
  .slice(0, 10)
  .map((p: any) => ({ id: p.id, nombre: p.title, slug: p.slug, foto: p.featuredImage }));

const apoyoComunidadList = allPostsFormatted.filter((p: any) => p.apoyoComunidad).slice(0, 10);

// Actualidad: ni destacados, ni personaje, ni apoyo; de lo más reciente a lo más antiguo
const actualidadPosts = generales
  .filter((p: any) => !idsDestacadosMarcados.has(p.id) && !idsTop5.has(p.id))
  .filter((p: any) => !EXCLUIR_6_A_12_DE_ACTUALIDAD || !usados.has(p.id))
  .slice(0, 12);

// Videos: todas las entradas con enlace de video (aunque sean destacadas), más recientes primero
const socialVideos = allPostsFormatted
  .filter((p: any) => p.videoYoutube || p.videoTiktok || p.videoInstagram)
  .slice(0, 12);

// ---------------------------------------------------------------------------
// ORDEN VISUAL EN MÓVIL Y TABLET (en escritorio cada elemento va en su columna)
// Las clases se escriben completas para que Tailwind las detecte.
// ---------------------------------------------------------------------------
const ORDEN_A: Record<number, string> = {
  1: 'order-1', 2: 'order-2', 3: 'order-3', 4: 'order-4', 5: 'order-5'
};
const ORDEN_B: Record<number, string> = {
  6: 'order-1', 7: 'order-2', 8: 'order-3', 9: 'order-5', 10: 'order-6', 11: 'order-7', 12: 'order-8'
};

const hayDiagnostico = MOSTRAR_DIAGNOSTICO && diagnostico.length > 0;
---

<Layout title="Realidades - Portal de Noticias">

  {/* BANNER 1: se coloca ENCIMA de la cabecera mediante el slot "top-banner" de Layout.astro */}
  {banner1Src && <TopBanner slot="top-banner" src={banner1Src} sticky={banner1Sticky} />}

  {/* ALERTA VISUAL DE DIAGNÓSTICO (se apaga con MOSTRAR_DIAGNOSTICO = false) */}
  {hayDiagnostico && (
    <div class="w-[90%] max-w-[1400px] mx-auto my-4 p-4 bg-red-100 border border-red-400 text-red-800 rounded-lg shadow-sm font-mono text-xs overflow-x-auto">
      <p class="font-bold text-sm mb-1">⚠️ DIAGNÓSTICO DE CONEXIÓN CON WORDPRESS</p>
      <p class="mb-2"><strong>API URL utilizada:</strong> {apiUrl}</p>
      <ul class="list-disc pl-5 mb-2">
        {diagnostico.map((d) => <li>{d}</li>)}
      </ul>
      {graphqlErrors.length > 0 && (
        <div>
          <strong>Errores devueltos por GraphQL:</strong>
          <pre class="bg-red-50 p-2 mt-1 rounded border border-red-200 text-[11px]">{JSON.stringify(graphqlErrors, null, 2)}</pre>
        </div>
      )}
    </div>
  )}

  <main class="w-[90%] max-w-[1400px] mx-auto my-6 font-sans">

    {/*
      BLOQUE A: posts 1-5 + Personaje + Actualidad + Apoyo.
      - Móvil (<590px): 1 columna, en el orden de las clases order-*.
      - Tablet (590-1024px): 2 columnas.
      - Escritorio (>1024px): 3 columnas. Cada columna es un flex vertical, así Actualidad
        queda pegada al Post 1 y no hay huecos.
      Las columnas usan "contents" en móvil/tablet para que sus hijos se ordenen todos juntos.
    */}
    <div class="grid grid-cols-1 min-[590px]:grid-cols-2 lg:grid-cols-12 gap-6 items-start lg:items-stretch">

      {/* Columna izquierda (25%): Post 2, Post 3, El Personaje */}
      <div class="contents lg:flex lg:flex-col lg:gap-6 lg:col-span-3">
        {[2, 3].map((n) => hayAlgo(n) && (
          <div class={ORDEN_A[n]}><SlotCard {...slot(n)} /></div>
        ))}
        {personajesList.length > 0 && (
          <div class="order-6 lg:flex-1 lg:flex lg:flex-col"><PersonajeCarousel personajes={personajesList} client:visible /></div>
        )}
      </div>

      {/* Columna central (50%): Post 1 y Actualidad */}
      <div class="contents lg:flex lg:flex-col lg:gap-6 lg:col-span-6">
        {posts[1] && (
          <article class="order-1 min-[590px]:col-span-2 lg:col-span-1">
            <a href={`/${posts[1].slug}`} class="group block">
              <h1 class="text-center text-2xl md:text-3xl font-extrabold text-gray-900 leading-tight mb-4 group-hover:text-blue-700 transition-colors">
                {posts[1].title}
              </h1>
              <div class="relative w-full aspect-[16/10] overflow-hidden rounded-xl bg-gray-100">
                <img src={posts[1].featuredImage} alt={posts[1].title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                {posts[1].videoYoutube && (
                  <span class="absolute bottom-4 left-4 inline-flex items-center gap-2 bg-black/70 text-white px-3 py-1.5 rounded-full text-sm font-medium">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    Ver video
                  </span>
                )}
              </div>
            </a>
            <div class="mt-4">
              {posts[1].insignia && (
                <span class="mr-2 text-xs font-bold uppercase text-emerald-700 bg-emerald-50 px-2 py-1 rounded">{posts[1].insignia}</span>
              )}
              {posts[1].actoresSociales?.[0] && (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border bg-gray-100 text-gray-700 border-gray-200">{posts[1].actoresSociales[0]}</span>
              )}
              <p class="mt-3 text-gray-700 text-base leading-relaxed line-clamp-4">{posts[1].excerpt}</p>
            </div>
          </article>
        )}
        {actualidadPosts.length > 0 && (
          <div class="order-7 min-[590px]:order-8 min-[590px]:col-span-2 lg:col-span-1 lg:flex-1 lg:flex lg:flex-col">
            <ActualidadCarousel posts={actualidadPosts} client:visible />
          </div>
        )}
      </div>

      {/* Columna derecha (25%): Post 4 (o Banner), Post 5, Apoyo a la Comunidad */}
      <div class="contents lg:flex lg:flex-col lg:gap-6 lg:col-span-3">
        {[4, 5].map((n) => hayAlgo(n) && (
          <div class={ORDEN_A[n]}><SlotCard {...slot(n)} /></div>
        ))}
        {apoyoComunidadList.length > 0 && (
          <div class="order-8 min-[590px]:order-7 lg:flex-1 lg:flex lg:flex-col"><ApoyoComunidadCarousel posts={apoyoComunidadList} client:visible /></div>
        )}
      </div>

    </div>

    {/* BANNER 2 ANCHO COMPLETO */}
    {banner2Src && (
      <div class="w-full my-8 flex justify-center items-center overflow-hidden rounded-xl bg-white">
        <img src={banner2Src} alt="Publicidad" class="w-full h-auto object-contain" />
      </div>
    )}

    {/*
      BLOQUE B: posts 6-12 + Videos.
      Escritorio: izquierda = 7, 8, 9 | centro = 6 + Videos | derecha = 10, 11, 12
      Móvil: 6 → 7 → 8 → Videos → 9 → 10 → 11 → 12
    */}
    <div class="grid grid-cols-1 min-[590px]:grid-cols-2 lg:grid-cols-12 gap-6 my-8 items-start">

      <div class="contents lg:flex lg:flex-col lg:gap-6 lg:col-span-3">
        {[7, 8, 9].map((n) => hayAlgo(n) && (
          <div class={ORDEN_B[n]}><SlotCard {...slot(n)} /></div>
        ))}
      </div>

      <div class="contents lg:flex lg:flex-col lg:gap-6 lg:col-span-6">
        {hayAlgo(6) && (
          <div class={`${ORDEN_B[6]} min-[590px]:col-span-2 lg:col-span-1`}><SlotCard {...slot(6)} /></div>
        )}
        {socialVideos.length > 0 && (
          <div class="order-4 min-[590px]:col-span-2 lg:col-span-1">
            <SocialVideoCarousel videos={socialVideos} client:visible />
          </div>
        )}
      </div>

      <div class="contents lg:flex lg:flex-col lg:gap-6 lg:col-span-3">
        {[10, 11, 12].map((n) => hayAlgo(n) && (
          <div class={ORDEN_B[n]}><SlotCard {...slot(n)} /></div>
        ))}
      </div>

    </div>

    {/* AUSPICIADORES */}
    {auspiciadoresReales.length > 0 && (
      <div class="my-12 pt-8 border-t border-gray-200">
        <h3 class="text-center text-xs font-bold uppercase tracking-widest text-gray-400 mb-6">
          Nuestros Auspiciadores
        </h3>
        <div class="flex flex-wrap justify-center items-center gap-8">
          {auspiciadoresReales.map((logoUrl) => (
            <img src={logoUrl} alt="Auspiciador" class="h-24 w-auto max-w-full object-contain hover:scale-105 transition-transform duration-300" />
          ))}
        </div>
      </div>
    )}

  </main>
</Layout>
