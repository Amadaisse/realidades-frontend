---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';

// Componentes interactivos de React (Islas)
import PersonajeCarousel from '../components/PersonajeCarousel.jsx';
import ActualidadCarousel from '../components/ActualidadCarousel.jsx';
import ApoyoComunidadCarousel from '../components/ApoyoComunidadCarousel.jsx';
import SocialVideoCarousel from '../components/SocialVideoCarousel.jsx';

import { posts as localPosts } from '../data/posts';

let wpPosts: any[] = [];
let pageConfig: any = null;

try {
  // Conexión dinámica usando la variable de entorno
  const apiUrl = import.meta.env.WORDPRESS_API_URL || 'https://realidades.lastorres308.com/graphql';

  const response = await fetch(apiUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      query: `
        query GetHomeAndBannersData {
          # 1. Banners y Auspiciadores desde la página 'configuracion-banners'
          page(id: "configuracion-banners", idType: URI) {
            bannersGlobales {
              banner1Imagen { sourceUrl }
              banner1Sticky
              banner2Imagen { sourceUrl }
              banner3Imagen { sourceUrl }
              logo1 { sourceUrl }
              logo2 { sourceUrl }
              logo3 { sourceUrl }
              logo4 { sourceUrl }
              logo5 { sourceUrl }
              logo6 { sourceUrl }
            }
          }

          # 2. Entradas reales de WordPress
          posts(first: 50, where: { orderby: { field: DATE, order: DESC } }) {
            nodes {
              id
              title
              slug
              date
              excerpt
              featuredImage {
                node {
                  sourceUrl
                }
              }
              camposMultimedia {
                urlVideoYoutube
                urlVideoTiktok
                urlVideoInstagram
              }
              actorsSociales {
                nodes {
                  name
                }
              }
              camposHome {
                insigniaNota
                destacadoHome
                ordenDestacado
                esPersonaje
                apoyoComunidad
              }
            }
          }
        }
      `
    })
  });

  const json = await response.json();
  wpPosts = json.data?.posts?.nodes || [];
  pageConfig = json.data?.page?.bannersGlobales || null;
} catch (error) {
  console.error("Error conectando con WordPress API:", error);
  wpPosts = [];
}

// FORMATO DE NOTICIAS
const allPostsFormatted = wpPosts.length > 0 
  ? wpPosts.map((post: any) => ({
      id: post.id,
      title: post.title,
      slug: post.slug,
      date: post.date,
      excerpt: post.excerpt ? post.excerpt.replace(/<[^>]*>/g, '') : '',
      featuredImage: post.featuredImage?.node?.sourceUrl || 'https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?w=1200',
      videoYoutube: post.camposMultimedia?.urlVideoYoutube || '',
      videoTiktok: post.camposMultimedia?.urlVideoTiktok || '',
      videoInstagram: post.camposMultimedia?.urlVideoInstagram || '',
      actoresSociales: post.actorsSociales?.nodes?.map((n: any) => typeof n === 'string' ? n : n?.name).filter(Boolean) || [],
      insignia: post.camposHome?.insigniaNota || '',
      destacadoHome: post.camposHome?.destacadoHome || 'ninguno',
      ordenDestacado: parseInt(post.camposHome?.ordenDestacado) || 99,
      esPersonaje: post.camposHome?.esPersonaje || false,
      apoyoComunidad: post.camposHome?.apoyoComunidad || false
    }))
  : localPosts;

const usedPostIds = new Set<string>();

// FILTRADO Y ORDEN DE DESTACADOS (POST 1 A POST 5)
const candidatosDestacados = allPostsFormatted.filter((p: any) => p.destacadoHome === 'destacados');

function obtenerDestacadoPorOrden(orden: number) {
  const encontrado = candidatosDestacados.find((p: any) => p.ordenDestacado === orden && !usedPostIds.has(p.id));
  if (encontrado) {
    usedPostIds.add(encontrado.id);
    return encontrado;
  }
  return null;
}

let post1 = obtenerDestacadoPorOrden(1);
let post2 = obtenerDestacadoPorOrden(2);
let post3 = obtenerDestacadoPorOrden(3);
let post4 = obtenerDestacadoPorOrden(4);
let post5 = obtenerDestacadoPorOrden(5);

const arrayDestacados = [post1, post2, post3, post4, post5];
const destacadosFinales = arrayDestacados.map(post => {
  if (post) return post;
  const relleno = allPostsFormatted.find((p: any) => !usedPostIds.has(p.id));
  if (relleno) {
    usedPostIds.add(relleno.id);
    return relleno;
  }
  return null;
}).filter(Boolean);

post1 = destacadosFinales[0] || allPostsFormatted[0];
post2 = destacadosFinales[1] || allPostsFormatted[1];
post3 = destacadosFinales[2] || allPostsFormatted[2];
post4 = destacadosFinales[3] || allPostsFormatted[3];
post5 = destacadosFinales[4] || allPostsFormatted[4];

if (post1) usedPostIds.add(post1.id);
if (post2) usedPostIds.add(post2.id);
if (post3) usedPostIds.add(post3.id);
if (post4) usedPostIds.add(post4.id);
if (post5) usedPostIds.add(post5.id);

// LISTAS PARA CARRUSELES
const personajesList = allPostsFormatted
  .filter((p: any) => p.esPersonaje)
  .slice(0, 5)
  .map((p: any) => ({
    id: p.id,
    nombre: p.title,
    slug: p.slug,
    foto: p.featuredImage
  }));

const apoyoComunidadList = allPostsFormatted
  .filter((p: any) => p.apoyoComunidad)
  .slice(0, 5);

const actualidadPosts = allPostsFormatted
  .filter((p: any) => !usedPostIds.has(p.id) && !p.esPersonaje)
  .slice(0, 12);

const socialVideos = allPostsFormatted
  .filter((p: any) => p.videoYoutube || p.videoTiktok || p.videoInstagram)
  .slice(0, 6);

const remainingPosts = allPostsFormatted.filter((p: any) => !usedPostIds.has(p.id));
const post6 = remainingPosts[0] || null;
const post8 = remainingPosts[1] || null;
const post9 = remainingPosts[2] || null;
const post10 = remainingPosts[3] || null;
const post11 = remainingPosts[4] || null;
const post12 = remainingPosts[5] || null;

// EXTRAER BANNERS Y AUSPICIADORES
const banner1Src = pageConfig?.banner1Imagen?.sourceUrl || '';
const banner1IsSticky = Boolean(pageConfig?.banner1Sticky);
const banner2Src = pageConfig?.banner2Imagen?.sourceUrl || '';
const banner3Src = pageConfig?.banner3Imagen?.sourceUrl || '';

// Lista limpia de auspiciadores subidos (filtramos los vacíos)
const auspiciadores = [
  pageConfig?.logo1?.sourceUrl,
  pageConfig?.logo2?.sourceUrl,
  pageConfig?.logo3?.sourceUrl,
  pageConfig?.logo4?.sourceUrl,
  pageConfig?.logo5?.sourceUrl,
  pageConfig?.logo6?.sourceUrl,
].filter(Boolean);
---

<Layout title="Realidades - Portal de Noticias">
  
  {/* BANNER 1 SUPERIOR (Se vuelve sticky SOLO si el check en WP está marcado) */}
  {banner1Src && (
    <div class={`w-full bg-white flex justify-center py-2 z-40 transition-all ${banner1IsSticky ? 'sticky top-0 shadow-md' : ''}`}>
      <div class="w-[90%] max-w-[1400px] flex justify-center items-center overflow-hidden">
        <img src={banner1Src} alt="Publicidad Cabecera" class="max-h-[100px] object-contain" />
      </div>
    </div>
  )}

  <main class="w-[90%] max-w-[1400px] mx-auto my-6 font-sans">
    
    {/* MALLA PRINCIPAL 3 COLUMNAS */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      {/* Columna Izquierda (25%) */}
      <div class="md:col-span-3 flex flex-col gap-6">
        {post2 && <NewsCard {...post2} />}
        {post3 && <NewsCard {...post3} />}
      </div>

      {/* Columna Central (50%) */}
      <div class="md:col-span-6 flex flex-col gap-6">
        {post1 && (
          <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100">
            <a href={`/${post1.slug}`} class="block group">
              <div class="relative h-72 md:h-96 w-full overflow-hidden bg-gray-100">
                <img src={post1.featuredImage} alt={post1.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                {post1.videoYoutube && (
                  <span class="absolute bottom-3 left-3 bg-red-600 text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1 shadow">
                    ▶ Ver video
                  </span>
                )}
              </div>
              <div class="p-5">
                {post1.insignia && <span class="text-xs font-bold uppercase text-emerald-600 bg-emerald-50 px-2 py-1 rounded">{post1.insignia}</span>}
                <h1 class="text-xl md:text-2xl font-bold text-gray-900 mt-2 group-hover:text-red-600 transition-colors leading-tight">
                  {post1.title}
                </h1>
                <p class="text-gray-600 text-sm mt-2 line-clamp-3">{post1.excerpt}</p>
              </div>
            </a>
          </div>
        )}
      </div>

      {/* Columna Derecha (25%) */}
      <div class="md:col-span-3 flex flex-col gap-6">
        {banner3Src ? (
          <div class="rounded-xl overflow-hidden shadow-sm bg-gray-50 flex items-center justify-center">
            <img src={banner3Src} alt="Publicidad Lateral" class="w-full h-full object-cover" />
          </div>
        ) : (
          post4 && <NewsCard {...post4} />
        )}
        {post5 && <NewsCard {...post5} />}
      </div>

    </div>

    {/* SECCIONES TRÍPTICO INTERMEDIO */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 my-8 items-start">
      <div class="md:col-span-3">
        <PersonajeCarousel personajes={personajesList} client:visible />
      </div>
      <div class="md:col-span-6">
        <ActualidadCarousel posts={actualidadPosts} client:visible />
      </div>
      <div class="md:col-span-3">
        <ApoyoComunidadCarousel posts={apoyoComunidadList} client:visible />
      </div>
    </div>

    {/* BANNER 2 ANCHO COMPLETO */}
    {banner2Src && (
      <div class="w-full my-8 flex justify-center items-center overflow-hidden rounded-xl bg-gray-50">
        <img src={banner2Src} alt="Banner Publicidad" class="w-full max-h-[120px] object-cover" />
      </div>
    )}

    {/* GRID INFERIOR (NOTICIAS Y VIDEOS) */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 my-8">
      <div class="md:col-span-3 flex flex-col gap-6">
        <div class="bg-amber-400 text-slate-900 font-bold p-6 rounded-xl min-h-[280px] flex items-center justify-center text-center shadow-sm">
          <span>ESPACIO PUBLICITARIO (336x300)</span>
        </div>
        {post8 && <NewsCard {...post8} />}
        {post9 && <NewsCard {...post9} />}
      </div>

      <div class="md:col-span-6 flex flex-col gap-6">
        {post6 && (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <NewsCard {...post6} />
          </div>
        )}
        <SocialVideoCarousel videos={socialVideos} client:visible />
      </div>

      <div class="md:col-span-3 flex flex-col gap-6">
        {post10 && <NewsCard {...post10} />}
        {post11 && <NewsCard {...post11} />}
        {post12 && <NewsCard {...post12} />}
      </div>
    </div>

    {/* SECCIÓN DE AUSPICIADORES DINÁMICOS */}
    {auspiciadores.length > 0 && (
      <div class="my-12 pt-8 border-t border-gray-200">
        <h3 class="text-center text-xs font-bold uppercase tracking-widest text-gray-400 mb-6">
          Nuestros Auspiciadores
        </h3>
        <div class="flex flex-wrap justify-center items-center gap-8">
          {auspiciadores.map((logoUrl) => (
            <div class="h-16 max-w-[180px] flex items-center justify-center p-2">
              <img src={logoUrl} alt="Auspiciador" class="max-h-full max-w-full object-contain grayscale hover:grayscale-0 transition-all duration-300" />
            </div>
          ))}
        </div>
      </div>
    )}

  </main>
</Layout>