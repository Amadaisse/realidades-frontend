---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import NewsCard from '../components/NewsCard.astro';

// Importamos tus posts locales de respaldo por seguridad
import { posts as localPosts } from '../data/posts';

let formattedPosts = [];

try {
  // Conectamos con tu WordPress de pruebas usando la variable de entorno
  const response = await fetch(import.meta.env.WORDPRESS_API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      query: `
        query GetLatestPosts {
          posts(first: 10, where: { orderby: { field: DATE, order: DESC } }) {
            nodes {
              id
              title
              excerpt
              date
              slug
              featuredImage {
                node {
                  sourceUrl
                }
              }
              camposMultimedia {
                urlVideoTiktok
                urlVideoYoutube
                urlVideoInstagram
              }
              actorsSociales {
                nodes {
                  name
                  slug
                }
              }
            }
          }
        }
      `
    })
  });

  const json = await response.json();
  const wpPosts = json.data?.posts?.nodes || [];

  if (wpPosts.length > 0) {
    // Si WordPress responde con entradas, estructuramos los datos para tus componentes
    formattedPosts = wpPosts.map((post: any) => ({
      title: post.title,
      slug: post.slug,
      date: post.date,
      excerpt: post.excerpt ? post.excerpt.replace(/<[^>]*>/g, '') : '', 
      featuredImage: post.featuredImage?.node?.sourceUrl || 'https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?w=1200',
      videoYoutube: post.camposMultimedia?.urlVideoYoutube || '',
      actoresSociales: post.actorsSociales?.nodes?.map((node: any) => node.name?.trim()).filter(Boolean) || []
    }));
  } else {
    formattedPosts = localPosts;
  }
} catch (error) {
  console.error("Error conectando a WordPress, usando datos locales:", error);
  formattedPosts = localPosts;
}

// Clasificamos las noticias para la interfaz
const featuredPost = formattedPosts[0];
const gridPosts = formattedPosts.slice(1);

// Configuración o placeholder del banner intercalado en la grilla (33.33% ancho)
const gridBanner = {
  image: 'https://placehold.co/600x700/60a5fa/ffffff?text=ancho+33.33%25%0Aalto+=+a+las+noticias',
  link: '#',
  title: 'Publicidad destacada'
};

// Definimos la posición exacta donde aparecerá el banner en la grilla (0 es primera tarjeta, 1 es la segunda)
const bannerIndexPosition = 1;
---

<Layout title="Realidades - Inicio">
    <main>
        {featuredPost && (
            <Hero
                title={featuredPost.title}
                slug={featuredPost.slug}
                date={featuredPost.date}
                excerpt={featuredPost.excerpt}
                featuredImage={featuredPost.featuredImage}
                actoresSociales={featuredPost.actoresSociales}
                videoYoutube={featuredPost.videoYoutube}
            />
        )}

        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="mb-8 flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">Ultimas Noticias</h2>
                    <p class="text-gray-600 mt-1">Mantente informado con las ultimas actualizaciones</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {gridPosts.map((post: any, index: number) => {
                    // Si el índice coincide con la posición deseada, mostramos el banner en lugar de la tarjeta de noticias
                    if (index === bannerIndexPosition && gridBanner) {
                        return (
                            <div class="bg-blue-400 rounded-xl overflow-hidden shadow-sm border border-blue-300 min-h-[380px] flex items-center justify-center hover:shadow-lg transition-shadow duration-300">
                                <a 
                                    href={gridBanner.link} 
                                    target="_blank" 
                                    rel="sponsored nofollow" 
                                    class="w-full h-full block group relative"
                                >
                                    <img 
                                        src={gridBanner.image} 
                                        alt={gridBanner.title} 
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    />
                                </a>
                            </div>
                        );
                    }

                    return (
                        <NewsCard
                            title={post.title}
                            slug={post.slug}
                            date={post.date}
                            excerpt={post.excerpt}
                            featuredImage={post.featuredImage}
                            actoresSociales={post.actoresSociales}
                            videoYoutube={post.videoYoutube}
                        />
                    );
                })}
            </div>
        </section>
    </main>
</Layout>