---
// src/components/NewsCard.astro

interface Props {
    title: string;
    slug: string;
    date: string;
    excerpt: string;
    featuredImage: string;
    actoresSociales: string[]; // CORREGIDO: Ahora acepta el arreglo de strings que envía index.astro
    videoYoutube?: string;
}

const { title, slug, date, excerpt, featuredImage, actoresSociales = [], videoYoutube } = Astro.props;

const postUrl = videoYoutube ? '/' + slug + '?autoplay=1' : '/' + slug;

const formattedDate = new Date(date).toLocaleDateString('es-PE', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
});

const actorColors: Record<string, string> = {
    'Gobierno': 'bg-emerald-100 text-emerald-700 border-emerald-200',
    'Oposicion': 'bg-orange-100 text-orange-700 border-orange-200',
    'Sociedad Civil': 'bg-purple-100 text-purple-700 border-purple-200',
    'Empresarios': 'bg-blue-100 text-blue-700 border-blue-200'
};

const getActorColor = (actorName: string): string => {
    return actorColors[actorName] || 'bg-gray-100 text-gray-700 border-gray-200';
};
---

<article class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col group">
    <a href={postUrl} class="block relative h-48 overflow-hidden">
        <img
            src={featuredImage}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
        />
        {videoYoutube && (
            <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                <div class="absolute bottom-4 left-4 inline-flex items-center gap-2 bg-black/70 text-white px-3 py-1.5 rounded-full text-sm font-medium">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                    </svg>
                    Ver video
                </div>
            </div>
        )}
    </a>

    <div class="p-5 flex flex-col flex-1">
        {actoresSociales.length > 0 && (
            <div class="flex flex-wrap items-center gap-2 mb-3">
                {actoresSociales.map((actorName) => (
                    <span class={'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ' + getActorColor(actorName)}>
                        {actorName}
                    </span>
                ))}
            </div>
        )}

        <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">
            <a href={postUrl}>
                {title}
            </a>
        </h3>

        <p class="text-gray-600 text-sm mb-4 line-clamp-2 flex-1">
            {excerpt}
        </p>

        <div class="flex items-center justify-between pt-3 border-t border-gray-100">
            <time class="text-gray-500 text-sm">
                {formattedDate}
            </time>
            <a
                href={postUrl}
                class="text-blue-600 text-sm font-medium hover:text-blue-800 transition-colors inline-flex items-center gap-1"
            >
                Leer
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>
    </div>
</article>